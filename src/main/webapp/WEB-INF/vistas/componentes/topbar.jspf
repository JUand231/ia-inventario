<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%-- Fragmento compartido: topbar de todas las páginas.
     Navegación completa: Inicio · Facturación · Productos · Entradas ·
     Salidas manuales · Alertas (el enlace de la página actual se resalta
     solo, según "paginaActiva" que setea cada vista).
     Marca "SacaClavos" con fuente elegante (clase marca__nombre--elegante).
     Si hay que cambiar la barra superior, se cambia SOLO AQUÍ. --%>
<header class="topbar">
    <div class="contenedor topbar--ia">
        <a class="marca" href="<c:url value='/inicio' />">
            <span class="marca__logo" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF"
                     stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7l9-4 9 4-9 4-9-4z"/>
                    <path d="M3 12l9 4 9-4"/>
                    <path d="M3 17l9 4 9-4"/>
                </svg>
            </span>
            <span class="marca__texto">
                <span class="marca__nombre marca__nombre--elegante">SacaClavos</span>
                <span class="marca__sub">Ferretería</span>
            </span>
        </a>

        <nav class="nav" aria-label="Navegación principal">
            <a class="nav__link${paginaActiva == 'inicio' ? ' nav__link--activo' : ''}"
               href="<c:url value='/inicio' />">Inicio</a>
            <a class="nav__link${paginaActiva == 'facturacion' ? ' nav__link--activo' : ''}"
               href="<c:url value='/facturacion' />">Facturación</a>
            <a class="nav__link${paginaActiva == 'productos' ? ' nav__link--activo' : ''}"
               href="<c:url value='/productos' />">Productos</a>
            <a class="nav__link${paginaActiva == 'entradas' ? ' nav__link--activo' : ''}"
               href="<c:url value='/entradas' />">Entradas</a>
            <a class="nav__link${paginaActiva == 'salidas' ? ' nav__link--activo' : ''}"
               href="<c:url value='/salidas' />">Salidas manuales</a>
            <a class="nav__link${paginaActiva == 'alertas' ? ' nav__link--activo' : ''}"
               href="<c:url value='/alertas' />">Alertas</a>
        </nav>

        <%-- Colonnete simétrico: ayuda a centrar la navegación --%>
        <span class="topbar__hueco" aria-hidden="true"></span>
    </div>
</header>
